---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  subtitle?: string;
  tag?: string;
  chapterNumber?: number;
  activeSlug?: string;
  handwrittenAnnotation?: string;
  description?: string;
}

const {
  title,
  subtitle,
  tag = 'System Design Study Journal',
  chapterNumber,
  activeSlug = 'index',
  handwrittenAnnotation,
  description = 'System Design & Database Architecture notes styled like a GoodNotes digital notebook planner.'
} = Astro.props;

const rawNotes = await getCollection('notes');
const allNotes = rawNotes.sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);

const currentIndex = allNotes.findIndex((n) => n.id === activeSlug);
const prevNote = currentIndex > 0 ? allNotes[currentIndex - 1] : null;
const nextNote = currentIndex >= 0 && currentIndex < allNotes.length - 1 ? allNotes[currentIndex + 1] : null;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{chapterNumber ? `${chapterNumber}. ${title} — System Design Notes` : `${title} — System Design Notes`}</title>
    <meta name="description" content={description}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Nunito:wght@400;600;700;800&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>

    <!-- Top Planner Toolbar -->
    <div class="toolbar">
        <a href={baseUrl} class="toolbar-title">
            <svg class="pen-icon" viewBox="0 0 24 24">
                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
            </svg>
            GoodNotes Architect Journal
        </a>
        <div class="toolbar-actions">
            <input type="text" id="searchInput" class="search-input" placeholder="Search notes..." onkeyup="filterNotes()">
            <button class="toggle-btn" id="themeToggleBtn" onclick="togglePaperTheme()">
                <span id="themeEmoji">🌙</span> <span id="themeModeText">Dark Paper</span>
            </button>
        </div>
    </div>

    <!-- GoodNotes Notebook Container -->
    <div class="notebook-container">
        
        <!-- Dynamic Notebook Tabs Header -->
        <div class="tabs-header">
            <a href={baseUrl} class={`tab-item ${activeSlug === 'index' ? 'active' : ''}`}>🏠 Index</a>
            <a href={`${baseUrl}reader/`} class={`tab-item ${activeSlug === 'reader' ? 'active' : ''}`} style="border-top-color: #ec4899; font-weight: 800;">
                📖 Interactive Flipbook
            </a>
            {allNotes.map((note) => (
                <a
                  href={`${baseUrl}notes/${note.id}/`}
                  class={`tab-item ${activeSlug === note.id ? 'active' : ''}`}
                >
                  {note.data.shortTitle || `${note.data.chapterNumber}. ${note.data.title}`}
                </a>
            ))}
        </div>

        <!-- Main Paper Page -->
        <div class="paper-page">
            
            <!-- Planner Cover Title -->
            <div class="planner-header">
                <span class="planner-tag">{tag}</span>
                <h1>{title}</h1>
                {subtitle && <p class="planner-subtitle">{subtitle}</p>}
                {handwrittenAnnotation && (
                    <div style="margin-top: 0.75rem;">
                        <span class="handwritten-annotation">{handwrittenAnnotation}</span>
                    </div>
                )}
            </div>

            <!-- Page Content (Markdown / MDX Slot) -->
            <slot />

            <!-- Planner Navigation Footer -->
            <footer class="chapter-nav-footer">
                <div class="nav-footer-inner">
                    {prevNote ? (
                        <a href={`${baseUrl}notes/${prevNote.id}/`} class="nav-btn prev-btn">
                            <span class="nav-btn-arrow">⬅️</span>
                            <div class="nav-btn-text">
                                <span class="nav-btn-label">Previous Chapter</span>
                                <span class="nav-btn-title">{prevNote.data.shortTitle || `${prevNote.data.chapterNumber}. ${prevNote.data.title}`}</span>
                            </div>
                        </a>
                    ) : (
                        <div class="nav-btn-placeholder"></div>
                    )}

                    <a href={baseUrl} class="nav-btn index-btn">
                        <span class="nav-btn-arrow">🏠</span>
                        <span class="nav-btn-title">Index</span>
                    </a>

                    {nextNote ? (
                        <a href={`${baseUrl}notes/${nextNote.id}/`} class="nav-btn next-btn">
                            <div class="nav-btn-text" style="text-align: right;">
                                <span class="nav-btn-label">Next Chapter</span>
                                <span class="nav-btn-title">{nextNote.data.shortTitle || `${nextNote.data.chapterNumber}. ${nextNote.data.title}`}</span>
                            </div>
                            <span class="nav-btn-arrow">➡️</span>
                        </a>
                    ) : (
                        <div class="nav-btn-placeholder"></div>
                    )}
                </div>
            </footer>
        </div>
    </div>

    <!-- Client-Side Notebook Utilities -->
    <script is:inline>
        function togglePaperTheme() {
            document.body.classList.toggle('dark-mode');
            const isDark = document.body.classList.contains('dark-mode');
            localStorage.setItem('goodnotes_theme', isDark ? 'dark' : 'light');
            updateThemeUI(isDark);
        }

        function updateThemeUI(isDark) {
            const modeText = document.getElementById('themeModeText');
            const themeEmoji = document.getElementById('themeEmoji');
            if (modeText) modeText.textContent = isDark ? 'Light Paper' : 'Dark Paper';
            if (themeEmoji) themeEmoji.textContent = isDark ? '☀️' : '🌙';
        }

        function applySavedTheme() {
            const savedTheme = localStorage.getItem('goodnotes_theme');
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);
            
            if (isDark) {
                document.body.classList.add('dark-mode');
            } else {
                document.body.classList.remove('dark-mode');
            }
            updateThemeUI(isDark);
        }

        // Apply immediately on load
        applySavedTheme();

        // Re-apply after View Transition swaps
        document.addEventListener('astro:after-swap', applySavedTheme);

        function copyCode(btn) {
            const container = btn.closest('.code-sticker');
            const code = container ? container.querySelector('code').innerText : '';
            if (!code) return;
            navigator.clipboard.writeText(code).then(() => {
                const orig = btn.textContent;
                btn.textContent = 'Copied!';
                btn.style.color = '#4ade80';
                setTimeout(() => {
                    btn.textContent = orig;
                    btn.style.color = '';
                }, 2000);
            });
        }

        function filterNotes() {
            const input = document.getElementById('searchInput');
            if (!input) return;
            const q = input.value.toLowerCase();
            const sections = document.querySelectorAll('.note-section, .toc-card');

            sections.forEach(sec => {
                const txt = sec.innerText.toLowerCase();
                sec.style.display = txt.includes(q) ? '' : 'none';
            });
        }
    </script>
</body>
</html>

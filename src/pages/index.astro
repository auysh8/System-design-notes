---
import { getCollection } from 'astro:content';
import NotebookLayout from '../layouts/NotebookLayout.astro';

const rawNotes = await getCollection('notes');
const allNotes = rawNotes.sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<NotebookLayout
  title="System Design & Database Architecture"
  subtitle="Modular Digital Planner Edition • Select a topic chapter below to study"
  tag="System Design Study Journal"
  activeSlug="index"
  handwrittenAnnotation="★ Modular system: easy to read & edit individual chapters!"
  description="System design and database architecture study notes styled like a GoodNotes digital notebook planner."
  <!-- Interactive Digital Notebook Banner -->
  <div style="background: linear-gradient(135deg, rgba(244, 114, 182, 0.12), rgba(56, 189, 248, 0.12)); border: 2px solid var(--border-soft); border-radius: 16px; padding: 1.5rem 2rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; box-shadow: var(--shadow-card);">
    <div>
      <span style="background: var(--pastel-pink); color: var(--pastel-pink-dark); font-size: 0.75rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 12px; text-transform: uppercase;">
        ✨ Physics Engine Enabled
      </span>
      <h2 style="font-family: var(--font-title); font-size: 1.4rem; margin: 0.5rem 0 0.25rem 0; color: var(--text-main);">
        Interactive Digital Flipbook
      </h2>
      <p style="color: var(--text-muted); margin: 0; font-size: 0.95rem;">
        Flip through all 10 chapters with realistic 3D paper corner dragging & page turn animations.
      </p>
    </div>
    <a href={`${baseUrl}reader/`} style="background: var(--pastel-yellow); color: #1e293b; border: 2px solid var(--text-main); padding: 0.75rem 1.5rem; border-radius: 12px; font-weight: 800; font-size: 0.95rem; text-decoration: none; box-shadow: 3px 3px 0px var(--text-main); display: inline-flex; align-items: center; gap: 6px;">
      📖 Open Interactive Book ➔
    </a>
  </div>

  <!-- Table of Contents Cards Grid -->
  <div class="toc-grid">
    {allNotes.map((note) => (
      <a href={`${baseUrl}notes/${note.id}/`} class={`toc-card card-accent-${note.data.accentColor}`}>
        <div>
          <div class="toc-number">{String(note.data.chapterNumber).padStart(2, '0')}</div>
          <div class="toc-title">{note.data.title}</div>
          <div class="toc-desc">{note.data.description}</div>
        </div>
        <div class="toc-link">
          Read Chapter ➔
        </div>
      </a>
    ))}
  </div>
</NotebookLayout>

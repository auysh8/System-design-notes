---
import NotebookLayout from '../layouts/NotebookLayout.astro';
import FlipbookViewer from '../components/FlipbookViewer.astro';

const { searchParams } = Astro.url;
const initialChapter = searchParams.get('chapter') || '';
---

<NotebookLayout
  title="Interactive Digital Notebook"
  subtitle="Flip through all 10 chapters with realistic 3D paper curl, drag physics & spiral binder navigation"
  tag="Interactive Flipbook Mode"
  activeSlug="reader"
  handwrittenAnnotation="✨ Drag any corner or use arrow keys to flip pages!"
>
  <FlipbookViewer initialSlug={initialChapter} />
</NotebookLayout>

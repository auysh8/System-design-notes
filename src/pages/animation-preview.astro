---
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page-Turn Animation Laboratory — System Design Notes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Nunito:wght@400;600;700;800&family=Fira+Code:wght@400;500;600&family=Caveat:wght@700&display=swap" rel="stylesheet">

    <!-- StPageFlip CDN for Option 2 Interactive Flipbook -->
    <script src="https://cdn.jsdelivr.net/npm/page-flip/dist/js/page-flip.browser.js" is:inline></script>

    <style>
        :root {
            --anim-speed: 600ms;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-main);
            font-family: var(--font-main);
            margin: 0;
            padding: 2rem 1.5rem;
            min-height: 100vh;
        }

        .lab-container {
            max-width: 1050px;
            margin: 0 auto;
        }

        .lab-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .lab-badge {
            background: var(--pastel-pink);
            color: var(--pastel-pink-dark);
            padding: 0.3rem 0.9rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: inline-block;
            margin-bottom: 0.75rem;
        }

        .dark-mode .lab-badge {
            background: #501d36;
            color: #f472b6;
        }

        .lab-header h1 {
            font-family: var(--font-title);
            font-size: 2.5rem;
            margin: 0 0 0.5rem 0;
        }

        .lab-header p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 650px;
            margin: 0 auto;
        }

        /* Control Panel */
        .controls-bar {
            background: var(--paper-card);
            border: 2px solid var(--border-soft);
            border-radius: 16px;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-card);
        }

        .option-tabs {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .option-tab {
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            color: var(--text-main);
            padding: 0.6rem 1.1rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .option-tab:hover {
            border-color: var(--pastel-blue-dark);
        }

        .option-tab.active {
            background: var(--pastel-blue);
            color: var(--pastel-blue-dark);
            border-color: var(--pastel-blue-dark);
            box-shadow: 2px 2px 0px var(--pastel-blue-dark);
        }

        .dark-mode .option-tab.active {
            background: #1e293b;
            color: #38bdf8;
            border-color: #38bdf8;
            box-shadow: 2px 2px 0px #38bdf8;
        }

        .speed-control {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* Stage Display */
        .stage-card {
            background: var(--paper-card);
            border: 2px solid var(--border-soft);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: var(--shadow-paper);
            position: relative;
            min-height: 520px;
            display: flex;
            flex-direction: column;
        }

        .stage-info {
            border-bottom: 2px dashed var(--border-soft);
            padding-bottom: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .stage-title {
            font-family: var(--font-title);
            font-size: 1.5rem;
            font-weight: 800;
            margin: 0 0 0.35rem 0;
            color: var(--text-main);
        }

        .stage-desc {
            color: var(--text-muted);
            margin: 0;
            font-size: 0.95rem;
            max-width: 600px;
        }

        .stage-actions {
            display: flex;
            gap: 0.75rem;
        }

        .action-btn {
            background: var(--paper-card);
            border: 2px solid var(--text-main);
            color: var(--text-main);
            padding: 0.6rem 1.25rem;
            border-radius: 10px;
            font-weight: 800;
            font-size: 0.9rem;
            cursor: pointer;
            box-shadow: 3px 3px 0px var(--text-main);
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .action-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0px var(--text-main);
        }

        .action-btn:active {
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0px var(--text-main);
        }

        .action-btn.primary {
            background: var(--pastel-yellow);
        }

        .dark-mode .action-btn.primary {
            background: #eab308;
            color: #0f172a;
        }

        /* Paper Simulation Viewport */
        .viewport-container {
            flex: 1;
            perspective: 1600px;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
            overflow: hidden;
        }

        /* Demo Paper Sheet */
        .demo-paper {
            width: 100%;
            max-width: 720px;
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            border-radius: 14px;
            padding: 2.25rem 2.5rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            position: absolute;
            transform-style: preserve-3d;
            backface-visibility: hidden;
            transition: transform var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1), opacity var(--anim-speed) ease, box-shadow var(--anim-speed) ease;
        }

        .dark-mode .demo-paper {
            background: #1e2433;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        /* Spiral Rings Demo */
        .demo-spiral-rings {
            position: absolute;
            top: 20px;
            left: 12px;
            bottom: 20px;
            width: 8px;
            background: repeating-linear-gradient(
                to bottom,
                #94a3b8 0px,
                #94a3b8 10px,
                transparent 10px,
                transparent 28px
            );
            border-radius: 4px;
            opacity: 0.4;
        }

        /* -------------------------------------------------------------
           OPTION 1: Curved 3D Paper Curl & Dynamic Glare
           ------------------------------------------------------------- */
        .demo-paper.opt1-exit-forward {
            transform-origin: left center;
            transform: perspective(1400px) rotateY(-85deg) skewY(-8deg) scale(0.92) translateX(-40px);
            opacity: 0;
            box-shadow: -35px 20px 45px rgba(0,0,0,0.35);
        }

        .demo-paper.opt1-enter-forward {
            transform-origin: left center;
            animation: opt1EnterFwd var(--anim-speed) cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        @keyframes opt1EnterFwd {
            0% {
                transform: perspective(1400px) rotateY(65deg) skewY(6deg) scale(0.92) translateX(40px);
                opacity: 0;
            }
            60% {
                opacity: 0.95;
            }
            100% {
                transform: perspective(1400px) rotateY(0deg) skewY(0deg) scale(1) translateX(0);
                opacity: 1;
            }
        }

        .demo-paper.opt1-exit-backward {
            transform-origin: right center;
            transform: perspective(1400px) rotateY(85deg) skewY(8deg) scale(0.92) translateX(40px);
            opacity: 0;
            box-shadow: 35px 20px 45px rgba(0,0,0,0.35);
        }

        .demo-paper.opt1-enter-backward {
            transform-origin: right center;
            animation: opt1EnterBwd var(--anim-speed) cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        @keyframes opt1EnterBwd {
            0% {
                transform: perspective(1400px) rotateY(-65deg) skewY(-6deg) scale(0.92) translateX(-40px);
                opacity: 0;
            }
            60% {
                opacity: 0.95;
            }
            100% {
                transform: perspective(1400px) rotateY(0deg) skewY(0deg) scale(1) translateX(0);
                opacity: 1;
            }
        }

        /* -------------------------------------------------------------
           OPTION 3: Spiral Ring Lift & Turn
           ------------------------------------------------------------- */
        .demo-paper.opt3-exit-forward {
            transform-origin: 15px center;
            transform: perspective(1200px) rotateY(-110deg) rotateZ(-4deg) translateY(-25px) scale(0.88);
            opacity: 0;
            box-shadow: -40px 10px 50px rgba(0,0,0,0.4);
        }

        .demo-paper.opt3-enter-forward {
            transform-origin: 15px center;
            animation: opt3EnterFwd var(--anim-speed) cubic-bezier(0.34, 1.3, 0.64, 1) forwards;
        }

        @keyframes opt3EnterFwd {
            0% {
                transform: perspective(1200px) translateY(40px) scale(0.95);
                opacity: 0;
            }
            100% {
                transform: perspective(1200px) translateY(0) scale(1);
                opacity: 1;
            }
        }

        /* -------------------------------------------------------------
           OPTION 4: Paper Stack Peel & Reveal (Diagonal Peel)
           ------------------------------------------------------------- */
        .demo-paper.opt4-exit-forward {
            transform-origin: bottom right;
            transform: rotate(-12deg) translate(-110%, -20%) scale(0.95);
            opacity: 0;
            box-shadow: -20px 30px 40px rgba(0,0,0,0.25);
        }

        .demo-paper.opt4-enter-forward {
            animation: opt4EnterFwd var(--anim-speed) cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
        }

        @keyframes opt4EnterFwd {
            0% {
                transform: scale(0.93) translateY(15px);
                opacity: 0.6;
            }
            100% {
                transform: scale(1) translateY(0);
                opacity: 1;
            }
        }

        /* Option 2 StPageFlip container */
        #flipbookContainer {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .flipbook-sheet {
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            padding: 2rem;
            box-sizing: border-box;
            border-radius: 8px;
            height: 100%;
            overflow: hidden;
        }

        .dark-mode .flipbook-sheet {
            background: #1e2433;
            color: #f1f5f9;
        }

        .back-nav-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--pastel-blue-dark);
            text-decoration: none;
            font-weight: 800;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="lab-container">
        
        <a href={baseUrl} class="back-nav-link">
            ⬅️ Back to Notebook
        </a>

        <!-- Lab Header -->
        <div class="lab-header">
            <span class="lab-badge">Interactive Physics Laboratory</span>
            <h1>Page-Turn Animation Showcase</h1>
            <p>Compare and test all 4 realistic notebook page-turning animations live with interactive controls before deciding on your preferred design.</p>
        </div>

        <!-- Controls Bar -->
        <div class="controls-bar">
            <div class="option-tabs">
                <button class="option-tab active" onclick="switchOption(1)">
                    🎨 Option 1: 3D Paper Curl & Glare
                </button>
                <button class="option-tab" onclick="switchOption(2)">
                    📖 Option 2: Drag-to-Peel Flipbook
                </button>
                <button class="option-tab" onclick="switchOption(3)">
                    📑 Option 3: Spiral Ring Lift & Turn
                </button>
                <button class="option-tab" onclick="switchOption(4)">
                    🗂️ Option 4: Layered Paper Stack Peel
                </button>
            </div>

            <div class="speed-control">
                <span>Speed:</span>
                <select id="speedSelect" onchange="changeSpeed(this.value)" style="background:var(--paper-bg); color:var(--text-main); border:1px solid var(--border-soft); padding:0.3rem 0.6rem; border-radius:6px; font-weight:700;">
                    <option value="900ms">0.5x (Slow Motion)</option>
                    <option value="600ms" selected>1.0x (Natural Speed)</option>
                    <option value="350ms">1.5x (Snappy)</option>
                </select>
                <button class="action-btn" onclick="document.body.classList.toggle('dark-mode')" style="padding:0.4rem 0.8rem; font-size:0.8rem;">
                    🌓 Toggle Dark
                </button>
            </div>
        </div>

        <!-- Simulation Stage -->
        <div class="stage-card">
            
            <div class="stage-info">
                <div>
                    <h2 class="stage-title" id="stageTitle">Option 1: Curved 3D Paper Curl & Glare</h2>
                    <p class="stage-desc" id="stageDesc">
                        Uses non-linear perspective deformation (skew + rotate) and directional physics so the page bends organically like flexible notebook paper instead of swinging like a flat board.
                    </p>
                </div>

                <div class="stage-actions" id="standardActions">
                    <button class="action-btn" onclick="triggerFlip('backward')">
                        ⬅️ Previous Page
                    </button>
                    <button class="action-btn primary" onclick="triggerFlip('forward')">
                        Next Page ➡️
                    </button>
                </div>
            </div>

            <!-- Viewport for CSS Options (1, 3, 4) -->
            <div class="viewport-container" id="cssViewport">
                
                <!-- Underneath / Next Page (Chapter 4) -->
                <div class="demo-paper" id="paperUnder" style="z-index: 1;">
                    <div class="demo-spiral-rings"></div>
                    <span class="planner-tag" style="background:var(--pastel-yellow); color:#854d0e; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 4</span>
                    <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.6rem;">ACID Transactions & Data Integrity</h2>
                    <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.6;">
                        Atomicity, Consistency, Isolation, and Durability guarantees in distributed relational clusters.
                    </p>
                    <div style="margin-top: 1.25rem;">
                        <mark class="hl-yellow">Atomicity</mark>
                        <mark class="hl-pink">Consistency</mark>
                        <mark class="hl-blue">Isolation</mark>
                        <mark class="hl-green">Durability</mark>
                    </div>
                </div>

                <!-- Active / Top Page (Chapter 3) -->
                <div class="demo-paper" id="paperTop" style="z-index: 2;">
                    <div class="demo-spiral-rings"></div>
                    <span class="planner-tag" style="background:var(--pastel-blue); color:#0369a1; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 3</span>
                    <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.6rem;">Relational Databases & SQL Joins</h2>
                    <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.6;">
                        Structured schemas, tables, primary keys, and foreign keys enforcing rigid data relationships.
                    </p>
                    <div style="margin-top: 1.25rem;">
                        <mark class="hl-blue">MySQL</mark>
                        <mark class="hl-blue">PostgreSQL</mark>
                        <mark class="hl-blue">SQLite</mark>
                        <mark class="hl-blue">Oracle</mark>
                    </div>
                    <div style="margin-top: 1.5rem; padding: 0.8rem; border-radius: 8px; background: var(--paper-card); border: 2px dashed var(--border-soft); font-family: var(--font-hand); font-size: 1.2rem; color: var(--text-muted);">
                        💡 "Tables store rows; relationships link keys."
                    </div>
                </div>

            </div>

            <!-- Viewport for Option 2 (StPageFlip Canvas) -->
            <div id="flipbookViewport" style="display: none; width: 100%; justify-content: center; align-items: center; padding: 2rem 0;">
                <div id="flipbookContainer" style="width: 600px; height: 380px;">
                    <div class="flipbook-sheet">
                        <span class="planner-tag" style="background:var(--pastel-blue); color:#0369a1; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 3</span>
                        <h3 style="font-family:var(--font-title); margin:0.5rem 0;">Relational Databases</h3>
                        <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.5;">
                            👉 <strong>Click & Drag this page corner with your mouse</strong> to peel the paper organically!
                        </p>
                        <div style="margin-top:1rem;">
                            <mark class="hl-blue">MySQL</mark> <mark class="hl-blue">PostgreSQL</mark>
                        </div>
                    </div>
                    <div class="flipbook-sheet">
                        <span class="planner-tag" style="background:var(--pastel-yellow); color:#854d0e; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 4</span>
                        <h3 style="font-family:var(--font-title); margin:0.5rem 0;">ACID Transactions</h3>
                        <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.5;">
                            All four ACID principles guarantee mission-critical financial correctness.
                        </p>
                        <div style="margin-top:1rem;">
                            <mark class="hl-yellow">Atomicity</mark> <mark class="hl-pink">Durability</mark>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- Interactive Laboratory Logic -->
    <script is:inline>
        let currentOption = 1;
        let isPageTopVisible = true;
        let pageFlipInstance = null;

        const optionData = {
            1: {
                title: "Option 1: Curved 3D Paper Curl & Glare",
                desc: "Uses non-linear perspective deformation (skew + rotate) and directional physics so the page bends organically like flexible notebook paper instead of swinging like a flat board."
            },
            2: {
                title: "Option 2: Drag-to-Peel Interactive Flipbook",
                desc: "True physics-based mesh deformation. Click and drag the corner with your mouse to peel, curl, and turn the page in real-time."
            },
            3: {
                title: "Option 3: Spiral Ring Lift & Turn",
                desc: "Simulates notebook sheets lifting off the spiral binder rings on the left and flipping over with dynamic depth drop-shadows."
            },
            4: {
                title: "Option 4: Layered Paper Stack Peel & Reveal",
                desc: "The outgoing chapter sheet peels diagonally with a smooth soft drop-shadow, revealing the next chapter sitting directly underneath in the notebook stack."
            }
        };

        function switchOption(opt) {
            currentOption = opt;

            // Update Tab UI
            document.querySelectorAll('.option-tab').forEach((tab, i) => {
                tab.classList.toggle('active', i + 1 === opt);
            });

            // Update Description
            document.getElementById('stageTitle').textContent = optionData[opt].title;
            document.getElementById('stageDesc').textContent = optionData[opt].desc;

            const cssViewport = document.getElementById('cssViewport');
            const flipbookViewport = document.getElementById('flipbookViewport');
            const standardActions = document.getElementById('standardActions');

            if (opt === 2) {
                cssViewport.style.display = 'none';
                flipbookViewport.style.display = 'flex';
                standardActions.style.display = 'none';
                initFlipbook();
            } else {
                cssViewport.style.display = 'flex';
                flipbookViewport.style.display = 'none';
                standardActions.style.display = 'flex';
                resetSheets();
            }
        }

        function changeSpeed(val) {
            document.documentElement.style.setProperty('--anim-speed', val);
        }

        function resetSheets() {
            const top = document.getElementById('paperTop');
            const under = document.getElementById('paperUnder');
            top.className = 'demo-paper';
            under.className = 'demo-paper';
            top.style.zIndex = '2';
            under.style.zIndex = '1';
            isPageTopVisible = true;
        }

        function triggerFlip(direction) {
            const top = document.getElementById('paperTop');
            const under = document.getElementById('paperUnder');
            
            const exitClass = `opt${currentOption}-exit-${direction}`;
            const enterClass = `opt${currentOption}-enter-${direction}`;

            if (isPageTopVisible) {
                top.classList.add(exitClass);
                under.classList.add(enterClass);
                setTimeout(() => {
                    top.style.zIndex = '1';
                    under.style.zIndex = '2';
                    isPageTopVisible = false;
                }, parseInt(getComputedStyle(document.documentElement).getPropertyValue('--anim-speed')));
            } else {
                top.classList.remove(exitClass);
                under.classList.remove(enterClass);
                top.classList.add(enterClass);
                under.classList.add(exitClass);
                setTimeout(() => {
                    top.style.zIndex = '2';
                    under.style.zIndex = '1';
                    isPageTopVisible = true;
                }, parseInt(getComputedStyle(document.documentElement).getPropertyValue('--anim-speed')));
            }
        }

        function initFlipbook() {
            if (pageFlipInstance) return;
            try {
                const target = document.getElementById('flipbookContainer');
                if (!target || !window.St || !window.St.PageFlip) return;
                
                pageFlipInstance = new St.PageFlip(target, {
                    width: 300,
                    height: 380,
                    size: 'stretch',
                    minWidth: 280,
                    maxWidth: 500,
                    minHeight: 350,
                    maxHeight: 600,
                    showCover: false,
                    drawShadow: true,
                    maxShadowOpacity: 0.5,
                    usePortrait: true
                });

                pageFlipInstance.loadFromHTML(document.querySelectorAll('.flipbook-sheet'));
            } catch(e) {
                console.error("Flipbook init error:", e);
            }
        }
    </script>
</body>
</html>

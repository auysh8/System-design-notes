---
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page-Turn Animation Laboratory — System Design Notes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Nunito:wght@400;600;700;800&family=Fira+Code:wght@400;500;600&family=Caveat:wght@700&display=swap" rel="stylesheet">

    <style>
        :root {
            --anim-speed: 650ms;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-main);
            font-family: var(--font-main);
            margin: 0;
            padding: 2rem 1.5rem;
            min-height: 100vh;
        }

        .lab-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .lab-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .lab-badge {
            background: var(--pastel-pink);
            color: var(--pastel-pink-dark);
            padding: 0.3rem 0.9rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: inline-block;
            margin-bottom: 0.75rem;
        }

        .dark-mode .lab-badge {
            background: #501d36;
            color: #f472b6;
        }

        .lab-header h1 {
            font-family: var(--font-title);
            font-size: 2.3rem;
            margin: 0 0 0.5rem 0;
        }

        .lab-header p {
            color: var(--text-muted);
            font-size: 1.05rem;
            max-width: 620px;
            margin: 0 auto;
        }

        /* Controls Bar */
        .controls-bar {
            background: var(--paper-card);
            border: 2px solid var(--border-soft);
            border-radius: 16px;
            padding: 1rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-card);
        }

        .option-tabs {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .option-tab {
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            color: var(--text-main);
            padding: 0.55rem 1rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .option-tab:hover {
            border-color: var(--pastel-blue-dark);
        }

        .option-tab.active {
            background: var(--pastel-blue);
            color: var(--pastel-blue-dark);
            border-color: var(--pastel-blue-dark);
            box-shadow: 2px 2px 0px var(--pastel-blue-dark);
        }

        .dark-mode .option-tab.active {
            background: #1e293b;
            color: #38bdf8;
            border-color: #38bdf8;
            box-shadow: 2px 2px 0px #38bdf8;
        }

        .controls-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        /* Stage Card */
        .stage-card {
            background: var(--paper-card);
            border: 2px solid var(--border-soft);
            border-radius: 20px;
            padding: 1.75rem 2rem 2.5rem 2rem;
            box-shadow: var(--shadow-paper);
            min-height: 560px;
            display: flex;
            flex-direction: column;
        }

        .stage-info {
            border-bottom: 2px dashed var(--border-soft);
            padding-bottom: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .stage-title {
            font-family: var(--font-title);
            font-size: 1.4rem;
            font-weight: 800;
            margin: 0 0 0.25rem 0;
            color: var(--text-main);
        }

        .stage-desc {
            color: var(--text-muted);
            margin: 0;
            font-size: 0.95rem;
            max-width: 580px;
        }

        .stage-actions {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .action-btn {
            background: var(--paper-card);
            border: 2px solid var(--text-main);
            color: var(--text-main);
            padding: 0.6rem 1.2rem;
            border-radius: 10px;
            font-weight: 800;
            font-size: 0.9rem;
            cursor: pointer;
            box-shadow: 3px 3px 0px var(--text-main);
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .action-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0px var(--text-main);
        }

        .action-btn:active {
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0px var(--text-main);
        }

        .action-btn.primary {
            background: var(--pastel-yellow);
        }

        .dark-mode .action-btn.primary {
            background: #eab308;
            color: #0f172a;
        }

        /* Viewport */
        .stage-viewport {
            flex: 1;
            position: relative;
            min-height: 420px;
            perspective: 1800px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 14px;
        }

        /* Paper Sheets */
        .sheet {
            width: 100%;
            max-width: 720px;
            min-height: 340px;
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            border-radius: 14px;
            padding: 2rem 2.5rem;
            box-shadow: var(--shadow-paper);
            box-sizing: border-box;
            position: absolute;
            transform-style: preserve-3d;
            backface-visibility: hidden;
            pointer-events: none;
            opacity: 0;
            transition: none;
        }

        .sheet.active {
            opacity: 1;
            pointer-events: auto;
            z-index: 5;
            transform: none;
        }

        .sheet.prev {
            opacity: 0;
            z-index: 1;
        }

        .dark-mode .sheet {
            background: #1e2433;
        }

        /* Spiral Rings on Left */
        .sheet-rings {
            position: absolute;
            top: 20px;
            left: 12px;
            bottom: 20px;
            width: 8px;
            background: repeating-linear-gradient(
                to bottom,
                #94a3b8 0px,
                #94a3b8 10px,
                transparent 10px,
                transparent 28px
            );
            border-radius: 4px;
            opacity: 0.4;
        }

        /* ========================================================
           OPTION 1: Curved 3D Paper Curl with Directional Physics
           ======================================================== */
        @keyframes opt1_fwd_out {
            0% {
                transform: perspective(1600px) rotateY(0deg) skewY(0deg) scale(1);
                opacity: 1;
                transform-origin: left center;
                box-shadow: var(--shadow-paper);
            }
            40% {
                box-shadow: -25px 15px 35px rgba(0,0,0,0.3);
            }
            100% {
                transform: perspective(1600px) rotateY(-80deg) skewY(-8deg) scale(0.92) translateX(-40px);
                opacity: 0;
                transform-origin: left center;
            }
        }

        @keyframes opt1_fwd_in {
            0% {
                transform: perspective(1600px) rotateY(70deg) skewY(6deg) scale(0.92) translateX(40px);
                opacity: 0;
                transform-origin: left center;
            }
            60% {
                opacity: 0.95;
            }
            100% {
                transform: perspective(1600px) rotateY(0deg) skewY(0deg) scale(1) translateX(0);
                opacity: 1;
                transform-origin: left center;
                box-shadow: var(--shadow-paper);
            }
        }

        @keyframes opt1_bwd_out {
            0% {
                transform: perspective(1600px) rotateY(0deg) skewY(0deg) scale(1);
                opacity: 1;
                transform-origin: right center;
                box-shadow: var(--shadow-paper);
            }
            40% {
                box-shadow: 25px 15px 35px rgba(0,0,0,0.3);
            }
            100% {
                transform: perspective(1600px) rotateY(80deg) skewY(8deg) scale(0.92) translateX(40px);
                opacity: 0;
                transform-origin: right center;
            }
        }

        @keyframes opt1_bwd_in {
            0% {
                transform: perspective(1600px) rotateY(-70deg) skewY(-6deg) scale(0.92) translateX(-40px);
                opacity: 0;
                transform-origin: right center;
            }
            60% {
                opacity: 0.95;
            }
            100% {
                transform: perspective(1600px) rotateY(0deg) skewY(0deg) scale(1) translateX(0);
                opacity: 1;
                transform-origin: right center;
                box-shadow: var(--shadow-paper);
            }
        }

        .opt1-fwd-out { animation: opt1_fwd_out var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1) forwards; }
        .opt1-fwd-in  { animation: opt1_fwd_in var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1) forwards; z-index: 6; }
        .opt1-bwd-out { animation: opt1_bwd_out var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1) forwards; }
        .opt1-bwd-in  { animation: opt1_bwd_in var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1) forwards; z-index: 6; }


        /* ========================================================
           OPTION 2: Interactive Real-Time Corner Peel & Curl
           ======================================================== */
        .opt2-container {
            width: 100%;
            max-width: 720px;
            height: 360px;
            position: relative;
            user-select: none;
            cursor: grab;
        }

        .opt2-container:active {
            cursor: grabbing;
        }

        .peel-page-back {
            position: absolute;
            inset: 0;
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            border-radius: 14px;
            padding: 2rem 2.5rem;
            box-shadow: var(--shadow-paper);
            box-sizing: border-box;
            z-index: 1;
        }

        .peel-page-front {
            position: absolute;
            inset: 0;
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            border-radius: 14px;
            padding: 2rem 2.5rem;
            box-shadow: var(--shadow-paper);
            box-sizing: border-box;
            z-index: 3;
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
            transition: clip-path 0.1s ease-out;
        }

        .dark-mode .peel-page-back, .dark-mode .peel-page-front {
            background: #1e2433;
        }

        .peel-fold-overlay {
            position: absolute;
            top: 0;
            right: 0;
            width: 0;
            height: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.85) 0%, rgba(220,220,220,0.95) 50%, rgba(180,180,180,0.8) 100%);
            box-shadow: -10px 10px 20px rgba(0,0,0,0.3);
            border-bottom-left-radius: 12px;
            z-index: 4;
            pointer-events: none;
            transition: width 0.1s ease-out, height 0.1s ease-out;
        }

        .dark-mode .peel-fold-overlay {
            background: linear-gradient(135deg, #334155 0%, #1e293b 50%, #0f172a 100%);
            box-shadow: -12px 12px 25px rgba(0,0,0,0.6);
        }


        /* ========================================================
           OPTION 3: Spiral Ring Lift & Turn
           ======================================================== */
        @keyframes opt3_fwd_out {
            0% {
                transform: perspective(1400px) rotateY(0deg) rotateZ(0deg) translateY(0);
                opacity: 1;
                transform-origin: 15px center;
            }
            100% {
                transform: perspective(1400px) rotateY(-115deg) rotateZ(-6deg) translateY(-30px) scale(0.9);
                opacity: 0;
                transform-origin: 15px center;
            }
        }

        @keyframes opt3_fwd_in {
            0% {
                transform: perspective(1400px) translateY(50px) scale(0.94);
                opacity: 0;
            }
            100% {
                transform: perspective(1400px) translateY(0) scale(1);
                opacity: 1;
            }
        }

        @keyframes opt3_bwd_out {
            0% {
                transform: perspective(1400px) translateY(0) scale(1);
                opacity: 1;
            }
            100% {
                transform: perspective(1400px) translateY(50px) scale(0.94);
                opacity: 0;
            }
        }

        @keyframes opt3_bwd_in {
            0% {
                transform: perspective(1400px) rotateY(-115deg) rotateZ(-6deg) translateY(-30px) scale(0.9);
                opacity: 0;
                transform-origin: 15px center;
            }
            100% {
                transform: perspective(1400px) rotateY(0deg) rotateZ(0deg) translateY(0) scale(1);
                opacity: 1;
                transform-origin: 15px center;
            }
        }

        .opt3-fwd-out { animation: opt3_fwd_out var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1) forwards; }
        .opt3-fwd-in  { animation: opt3_fwd_in var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1) forwards; z-index: 6; }
        .opt3-bwd-out { animation: opt3_bwd_out var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1) forwards; }
        .opt3-bwd-in  { animation: opt3_bwd_in var(--anim-speed) cubic-bezier(0.25, 1, 0.5, 1) forwards; z-index: 6; }


        /* ========================================================
           OPTION 4: Layered Paper Stack Peel & Reveal
           ======================================================== */
        @keyframes opt4_fwd_out {
            0% {
                transform: rotate(0deg) translate(0, 0) scale(1);
                opacity: 1;
                transform-origin: bottom right;
            }
            100% {
                transform: rotate(-14deg) translate(-115%, -25%) scale(0.95);
                opacity: 0;
                transform-origin: bottom right;
            }
        }

        @keyframes opt4_fwd_in {
            0% {
                transform: scale(0.93) translateY(20px);
                opacity: 0.5;
            }
            100% {
                transform: scale(1) translateY(0);
                opacity: 1;
            }
        }

        @keyframes opt4_bwd_out {
            0% {
                transform: scale(1) translateY(0);
                opacity: 1;
            }
            100% {
                transform: scale(0.93) translateY(20px);
                opacity: 0.5;
            }
        }

        @keyframes opt4_bwd_in {
            0% {
                transform: rotate(-14deg) translate(-115%, -25%) scale(0.95);
                opacity: 0;
                transform-origin: bottom right;
            }
            100% {
                transform: rotate(0deg) translate(0, 0) scale(1);
                opacity: 1;
                transform-origin: bottom right;
            }
        }

        .opt4-fwd-out { animation: opt4_fwd_out var(--anim-speed) cubic-bezier(0.2, 0.9, 0.3, 1) forwards; }
        .opt4-fwd-in  { animation: opt4_fwd_in var(--anim-speed) cubic-bezier(0.2, 0.9, 0.3, 1) forwards; z-index: 6; }
        .opt4-bwd-out { animation: opt4_bwd_out var(--anim-speed) cubic-bezier(0.2, 0.9, 0.3, 1) forwards; }
        .opt4-bwd-in  { animation: opt4_bwd_in var(--anim-speed) cubic-bezier(0.2, 0.9, 0.3, 1) forwards; z-index: 6; }

        .back-nav-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--pastel-blue-dark);
            text-decoration: none;
            font-weight: 800;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="lab-container">
        
        <a href={baseUrl} class="back-nav-link">
            ⬅️ Back to Notebook
        </a>

        <!-- Lab Header -->
        <div class="lab-header">
            <span class="lab-badge">Interactive Physics Laboratory</span>
            <h1>Page-Turn Animation Showcase</h1>
            <p>Test and compare all 4 realistic notebook page-turning animations live with interactive controls before deciding on your preferred design.</p>
        </div>

        <!-- Controls Bar -->
        <div class="controls-bar">
            <div class="option-tabs">
                <button class="option-tab active" onclick="switchTab(1)">
                    🎨 Option 1: 3D Paper Curl
                </button>
                <button class="option-tab" onclick="switchTab(2)">
                    📖 Option 2: Drag-to-Peel
                </button>
                <button class="option-tab" onclick="switchTab(3)">
                    📑 Option 3: Spiral Ring Lift
                </button>
                <button class="option-tab" onclick="switchTab(4)">
                    🗂️ Option 4: Layered Stack Peel
                </button>
            </div>

            <div class="controls-right">
                <span style="font-size:0.85rem; font-weight:700; color:var(--text-muted);">Speed:</span>
                <select id="speedSelect" onchange="changeSpeed(this.value)" style="background:var(--paper-bg); color:var(--text-main); border:1px solid var(--border-soft); padding:0.35rem 0.6rem; border-radius:6px; font-weight:700; cursor:pointer;">
                    <option value="950ms">0.5x Slow Motion</option>
                    <option value="650ms" selected>1.0x Natural Speed</option>
                    <option value="380ms">1.5x Snappy Speed</option>
                </select>
                <button class="action-btn" onclick="document.body.classList.toggle('dark-mode')" style="padding:0.35rem 0.75rem; font-size:0.82rem;">
                    🌓 Dark Mode
                </button>
            </div>
        </div>

        <!-- Stage Card -->
        <div class="stage-card">
            
            <div class="stage-info">
                <div>
                    <h2 class="stage-title" id="stageTitle">Option 1: Curved 3D Paper Curl with Directional Physics</h2>
                    <p class="stage-desc" id="stageDesc">
                        Uses non-linear perspective deformation (skew + rotate) and directional physics so the page bends organically like flexible notebook paper instead of swinging like a flat board.
                    </p>
                </div>

                <div class="stage-actions" id="standardActions">
                    <button class="action-btn" onclick="runTransition('backward')">
                        ⬅️ Previous Page
                    </button>
                    <button class="action-btn primary" onclick="runTransition('forward')">
                        Next Page ➡️
                    </button>
                </div>
            </div>

            <!-- Standard Viewport (Options 1, 3, 4) -->
            <div class="stage-viewport" id="standardViewport">
                
                <!-- Page 1: Chapter 3 -->
                <div class="sheet active" id="sheet1">
                    <div class="sheet-rings"></div>
                    <span class="planner-tag" style="background:var(--pastel-blue); color:#0369a1; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 3</span>
                    <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.6rem;">Relational Databases & SQL Joins</h2>
                    <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.6;">
                        Structured schemas, tables, primary keys, and foreign keys enforcing rigid data relationships.
                    </p>
                    <div style="margin-top: 1.25rem;">
                        <mark class="hl-blue">MySQL</mark>
                        <mark class="hl-blue">PostgreSQL</mark>
                        <mark class="hl-blue">SQLite</mark>
                        <mark class="hl-blue">Oracle</mark>
                    </div>
                    <div style="margin-top: 1.5rem; padding: 0.8rem; border-radius: 8px; background: var(--paper-card); border: 2px dashed var(--border-soft); font-family: var(--font-hand); font-size: 1.2rem; color: var(--text-muted);">
                        💡 "Tables store rows; relationships link keys."
                    </div>
                </div>

                <!-- Page 2: Chapter 4 -->
                <div class="sheet prev" id="sheet2">
                    <div class="sheet-rings"></div>
                    <span class="planner-tag" style="background:var(--pastel-yellow); color:#854d0e; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 4</span>
                    <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.6rem;">ACID Transactions & Data Integrity</h2>
                    <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.6;">
                        Atomicity, Consistency, Isolation, and Durability guarantees across relational databases.
                    </p>
                    <div style="margin-top: 1.25rem;">
                        <mark class="hl-yellow">Atomicity</mark>
                        <mark class="hl-pink">Consistency</mark>
                        <mark class="hl-blue">Isolation</mark>
                        <mark class="hl-green">Durability</mark>
                    </div>
                    <div style="margin-top: 1.5rem; padding: 0.8rem; border-radius: 8px; background: var(--paper-card); border: 2px dashed var(--border-soft); font-family: var(--font-hand); font-size: 1.2rem; color: var(--text-muted);">
                        ⚡ "All or nothing: either the transaction commits completely or rolls back."
                    </div>
                </div>

            </div>

            <!-- Interactive Drag Viewport (Option 2) -->
            <div class="stage-viewport" id="dragViewport" style="display: none;">
                <div class="opt2-container" id="peelContainer">
                    
                    <!-- Back Sheet (Chapter 4) -->
                    <div class="peel-page-back">
                        <div class="sheet-rings"></div>
                        <span class="planner-tag" style="background:var(--pastel-yellow); color:#854d0e; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 4</span>
                        <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.6rem;">ACID Transactions & Data Integrity</h2>
                        <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.6;">
                            Atomicity, Consistency, Isolation, and Durability guarantees across relational databases.
                        </p>
                        <div style="margin-top: 1.25rem;">
                            <mark class="hl-yellow">Atomicity</mark>
                            <mark class="hl-pink">Consistency</mark>
                            <mark class="hl-blue">Isolation</mark>
                            <mark class="hl-green">Durability</mark>
                        </div>
                    </div>

                    <!-- Front Sheet (Chapter 3) -->
                    <div class="peel-page-front" id="peelFront">
                        <div class="sheet-rings"></div>
                        <span class="planner-tag" style="background:var(--pastel-blue); color:#0369a1; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 3</span>
                        <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.6rem;">Relational Databases & SQL Joins</h2>
                        <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.6;">
                            👉 <strong>Click & Drag anywhere on this card</strong> (or drag the top-right corner) to peel the page like real paper!
                        </p>
                        <div style="margin-top: 1.25rem;">
                            <mark class="hl-blue">MySQL</mark>
                            <mark class="hl-blue">PostgreSQL</mark>
                            <mark class="hl-blue">SQLite</mark>
                        </div>
                        <div style="margin-top: 1.5rem; padding: 0.7rem; border-radius: 8px; background: var(--paper-card); border: 2px dashed var(--border-soft); font-family: var(--font-hand); font-size: 1.15rem; color: var(--pastel-blue-dark);">
                            ✨ Move mouse to peel paper corner in real-time
                        </div>
                    </div>

                    <!-- Corner Fold Overlay -->
                    <div class="peel-fold-overlay" id="peelFold"></div>

                </div>
            </div>

        </div>

    </div>

    <script is:inline>
        let currentTab = 1;
        let currentPage = 1;
        let isAnimating = false;

        const tabMetadata = {
            1: {
                title: "Option 1: Curved 3D Paper Curl with Directional Physics",
                desc: "Uses non-linear perspective deformation (skew + rotate) and directional physics so the page bends organically like flexible notebook paper instead of swinging like a flat board."
            },
            2: {
                title: "Option 2: Drag-to-Peel Interactive Corner Simulation",
                desc: "Click and drag across the page to peel, bend, and curl the corner with dynamic realistic paper fold lighting in real-time."
            },
            3: {
                title: "Option 3: Spiral Ring Lift & Turn",
                desc: "Simulates notebook sheets lifting off the spiral binder rings on the left and flipping over with dynamic depth drop-shadows."
            },
            4: {
                title: "Option 4: Layered Paper Stack Peel & Reveal",
                desc: "The outgoing chapter sheet peels diagonally with a smooth soft drop-shadow, revealing the next chapter sitting directly underneath in the notebook stack."
            }
        };

        function switchTab(tabNum) {
            currentTab = tabNum;

            document.querySelectorAll('.option-tab').forEach((t, i) => {
                t.classList.toggle('active', i + 1 === tabNum);
            });

            document.getElementById('stageTitle').textContent = tabMetadata[tabNum].title;
            document.getElementById('stageDesc').textContent = tabMetadata[tabNum].desc;

            const standardViewport = document.getElementById('standardViewport');
            const dragViewport = document.getElementById('dragViewport');
            const standardActions = document.getElementById('standardActions');

            if (tabNum === 2) {
                standardViewport.style.display = 'none';
                dragViewport.style.display = 'flex';
                standardActions.style.display = 'none';
                initPeelDrag();
            } else {
                standardViewport.style.display = 'flex';
                dragViewport.style.display = 'none';
                standardActions.style.display = 'flex';
                resetStandardSheets();
            }
        }

        function changeSpeed(val) {
            document.documentElement.style.setProperty('--anim-speed', val);
        }

        function resetStandardSheets() {
            const s1 = document.getElementById('sheet1');
            const s2 = document.getElementById('sheet2');
            s1.className = 'sheet active';
            s2.className = 'sheet prev';
            currentPage = 1;
            isAnimating = false;
        }

        function runTransition(direction) {
            if (isAnimating) return;
            isAnimating = true;

            const s1 = document.getElementById('sheet1');
            const s2 = document.getElementById('sheet2');

            const currentSheet = currentPage === 1 ? s1 : s2;
            const nextSheet = currentPage === 1 ? s2 : s1;

            const outClass = `opt${currentTab}-${direction === 'forward' ? 'fwd' : 'bwd'}-out`;
            const inClass = `opt${currentTab}-${direction === 'forward' ? 'fwd' : 'bwd'}-in`;

            currentSheet.className = `sheet ${outClass}`;
            nextSheet.className = `sheet ${inClass}`;

            const duration = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--anim-speed')) || 650;

            setTimeout(() => {
                currentSheet.className = 'sheet prev';
                nextSheet.className = 'sheet active';
                currentPage = currentPage === 1 ? 2 : 1;
                isAnimating = false;
            }, duration);
        }

        /* -------------------------------------------------------------
           Option 2 Interactive Corner Drag Logic
           ------------------------------------------------------------- */
        let isDragging = false;
        let peelInitialized = false;

        function initPeelDrag() {
            if (peelInitialized) return;
            peelInitialized = true;

            const container = document.getElementById('peelContainer');
            const front = document.getElementById('peelFront');
            const fold = document.getElementById('peelFold');

            function handleMove(clientX, clientY) {
                const rect = container.getBoundingClientRect();
                const x = clientX - rect.left;
                const y = clientY - rect.top;

                const dx = Math.max(0, rect.width - x);
                const dy = Math.max(0, y);
                const peelSize = Math.min(Math.hypot(dx, dy) * 1.15, rect.width);

                if (peelSize > 10) {
                    const pctX = Math.max(0, 100 - (peelSize / rect.width * 100));
                    const pctY = Math.min(100, (peelSize / rect.height * 100));
                    front.style.clipPath = `polygon(0 0, ${pctX}% 0, 100% ${pctY}%, 100% 100%, 0 100%)`;
                    fold.style.width = `${peelSize}px`;
                    fold.style.height = `${peelSize}px`;
                } else {
                    front.style.clipPath = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
                    fold.style.width = '0px';
                    fold.style.height = '0px';
                }
            }

            container.addEventListener('mousedown', (e) => {
                isDragging = true;
                handleMove(e.clientX, e.clientY);
            });

            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                handleMove(e.clientX, e.clientY);
            });

            window.addEventListener('mouseup', () => {
                if (!isDragging) return;
                isDragging = false;
                // Animate back to open
                front.style.transition = 'clip-path 0.4s ease';
                fold.style.transition = 'width 0.4s ease, height 0.4s ease';
                front.style.clipPath = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
                fold.style.width = '0px';
                fold.style.height = '0px';
                setTimeout(() => {
                    front.style.transition = 'none';
                    fold.style.transition = 'none';
                }, 400);
            });

            // Touch support
            container.addEventListener('touchstart', (e) => {
                isDragging = true;
                handleMove(e.touches[0].clientX, e.touches[0].clientY);
            });

            window.addEventListener('touchmove', (e) => {
                if (!isDragging) return;
                handleMove(e.touches[0].clientX, e.touches[0].clientY);
            });

            window.addEventListener('touchend', () => {
                isDragging = false;
                front.style.transition = 'clip-path 0.4s ease';
                fold.style.transition = 'width 0.4s ease, height 0.4s ease';
                front.style.clipPath = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
                fold.style.width = '0px';
                fold.style.height = '0px';
                setTimeout(() => {
                    front.style.transition = 'none';
                    fold.style.transition = 'none';
                }, 400);
            });
        }
    </script>
</body>
</html>

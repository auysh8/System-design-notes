---
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Comparison: Page-Flip vs GSAP 3D — System Design Notes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Nunito:wght@400;600;700;800&family=Fira+Code:wght@400;500;600&family=Caveat:wght@700&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: var(--bg-canvas);
            color: var(--text-main);
            font-family: var(--font-main);
            margin: 0;
            padding: 2rem 1.5rem;
            min-height: 100vh;
        }

        .preview-wrapper {
            max-width: 1100px;
            margin: 0 auto;
        }

        .header-section {
            text-align: center;
            margin-bottom: 2rem;
        }

        .badge {
            background: var(--pastel-purple);
            color: var(--pastel-purple-dark);
            padding: 0.35rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: inline-block;
            margin-bottom: 0.75rem;
        }

        .dark-mode .badge {
            background: #3b1d4e;
            color: #d8b4fe;
        }

        .header-section h1 {
            font-family: var(--font-title);
            font-size: 2.4rem;
            margin: 0 0 0.5rem 0;
        }

        .header-section p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto;
        }

        /* Mode Selector */
        .library-toggle-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--paper-card);
            border: 2px solid var(--border-soft);
            border-radius: 16px;
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-card);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .lib-buttons {
            display: flex;
            gap: 0.75rem;
        }

        .lib-btn {
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            color: var(--text-main);
            padding: 0.7rem 1.4rem;
            border-radius: 12px;
            font-weight: 800;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .lib-btn:hover {
            border-color: var(--pastel-blue-dark);
        }

        .lib-btn.active {
            background: var(--pastel-blue);
            color: var(--pastel-blue-dark);
            border-color: var(--pastel-blue-dark);
            box-shadow: 3px 3px 0px var(--pastel-blue-dark);
        }

        .dark-mode .lib-btn.active {
            background: #1e293b;
            color: #38bdf8;
            border-color: #38bdf8;
            box-shadow: 3px 3px 0px #38bdf8;
        }

        /* Demo Container */
        .demo-card {
            background: var(--paper-card);
            border: 2px solid var(--border-soft);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: var(--shadow-paper);
            min-height: 580px;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .demo-header {
            border-bottom: 2px dashed var(--border-soft);
            padding-bottom: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .demo-title {
            font-family: var(--font-title);
            font-size: 1.45rem;
            font-weight: 800;
            margin: 0 0 0.35rem 0;
        }

        .demo-desc {
            color: var(--text-muted);
            margin: 0;
            font-size: 0.95rem;
            max-width: 600px;
        }

        .action-btn {
            background: var(--paper-card);
            border: 2px solid var(--text-main);
            color: var(--text-main);
            padding: 0.65rem 1.35rem;
            border-radius: 10px;
            font-weight: 800;
            font-size: 0.92rem;
            cursor: pointer;
            box-shadow: 3px 3px 0px var(--text-main);
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .action-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0px var(--text-main);
        }

        .action-btn:active {
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0px var(--text-main);
        }

        .action-btn.primary {
            background: var(--pastel-yellow);
        }

        .dark-mode .action-btn.primary {
            background: #eab308;
            color: #0f172a;
        }

        /* -------------------------------------------------------------
           1. StPageFlip Arena
           ------------------------------------------------------------- */
        #pageFlipArena {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1.5rem 0;
            width: 100%;
        }

        #bookContainer {
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
            border-radius: 10px;
            overflow: visible;
        }

        .pf-page {
            background-color: var(--paper-bg);
            border: 2px solid var(--border-soft);
            padding: 2.25rem;
            box-sizing: border-box;
            color: var(--text-main);
            position: relative;
        }

        .dark-mode .pf-page {
            background-color: #1e2433;
            color: #f1f5f9;
        }

        /* Spiral Binder Rings on Left of each page */
        .pf-rings {
            position: absolute;
            top: 20px;
            left: 12px;
            bottom: 20px;
            width: 8px;
            background: repeating-linear-gradient(
                to bottom,
                #94a3b8 0px,
                #94a3b8 10px,
                transparent 10px,
                transparent 28px
            );
            border-radius: 4px;
            opacity: 0.4;
        }

        /* -------------------------------------------------------------
           2. GSAP 3D Stage
           ------------------------------------------------------------- */
        #gsapArena {
            display: none;
            flex: 1;
            perspective: 1800px;
            position: relative;
            align-items: center;
            justify-content: center;
            padding: 1rem 0;
            min-height: 400px;
        }

        .gsap-sheet {
            width: 100%;
            max-width: 720px;
            min-height: 350px;
            background: var(--paper-bg);
            border: 2px solid var(--border-soft);
            border-radius: 14px;
            padding: 2.25rem 2.5rem;
            box-shadow: var(--shadow-paper);
            box-sizing: border-box;
            position: absolute;
            transform-style: preserve-3d;
            backface-visibility: hidden;
            color: var(--text-main);
        }

        .dark-mode .gsap-sheet {
            background: #1e2433;
            color: #f1f5f9;
        }

        .back-nav-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--pastel-blue-dark);
            text-decoration: none;
            font-weight: 800;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="preview-wrapper">
        
        <a href={baseUrl} class="back-nav-link">
            ⬅️ Back to Notebook
        </a>

        <div class="header-section">
            <span class="badge">Animation Library Comparison</span>
            <h1>Real-Time Animation Showcase</h1>
            <p>Compare the two leading JavaScript animation libraries running live inside your project.</p>
        </div>

        <!-- Toggle Controls -->
        <div class="library-toggle-bar">
            <div class="lib-buttons">
                <button class="lib-btn active" id="btnPageFlip" onclick="showLibrary('pageflip')">
                    📖 1. <code>page-flip</code> (Interactive Physics)
                </button>
                <button class="lib-btn" id="btnGsap" onclick="showLibrary('gsap')">
                    ⚡ 2. <code>GSAP</code> (3D Paper Flip Timeline)
                </button>
            </div>

            <div style="display: flex; gap: 0.75rem; align-items: center;">
                <button class="action-btn" onclick="document.body.classList.toggle('dark-mode')" style="padding: 0.5rem 1rem;">
                    🌓 Toggle Dark
                </button>
            </div>
        </div>

        <!-- Demo Stage -->
        <div class="demo-card">
            
            <!-- PageFlip Info Header -->
            <div class="demo-header" id="pageFlipHeader">
                <div>
                    <h2 class="demo-title">Library 1: <code>page-flip</code> (StPageFlip)</h2>
                    <p class="demo-desc">
                        👉 <strong>Grab and drag any page corner with your mouse</strong> or use the buttons below. It simulates full canvas mesh deformation, corner curling, and dynamic shadows.
                    </p>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <button class="action-btn" id="pfPrevBtn">⬅️ Flip Back</button>
                    <button class="action-btn primary" id="pfNextBtn">Flip Next ➡️</button>
                </div>
            </div>

            <!-- GSAP Info Header -->
            <div class="demo-header" id="gsapHeader" style="display: none;">
                <div>
                    <h2 class="demo-title">Library 2: <code>GSAP</code> (GreenSock 3D Transforms)</h2>
                    <p class="demo-desc">
                        Uses GSAP's physics engine (`power3.inOut` + 3D matrix curvature) to smoothly curl and turn the page with 60fps GPU acceleration.
                    </p>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <button class="action-btn" id="gsapPrevBtn">⬅️ Previous Chapter</button>
                    <button class="action-btn primary" id="gsapNextBtn">Next Chapter ➡️</button>
                </div>
            </div>

            <!-- 1. StPageFlip Arena -->
            <div id="pageFlipArena">
                <div id="bookContainer">
                    
                    <!-- Page 1: Chapter 1 -->
                    <div class="pf-page" data-density="hard">
                        <div class="pf-rings"></div>
                        <span class="planner-tag" style="background:var(--pastel-green); color:#15803d; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 1</span>
                        <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.5rem;">Single Server Architecture</h2>
                        <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.5;">
                            Every system starts small. A single node hosting the Web Server, App Server, and Database all on one physical machine.
                        </p>
                        <div style="margin-top: 1.25rem;">
                            <mark class="hl-green">Single Host</mark> <mark class="hl-yellow">DNS Resolution</mark> <mark class="hl-pink">SPOF</mark>
                        </div>
                        <div style="margin-top: 1.5rem; padding: 0.75rem; border-radius: 8px; background: var(--paper-card); border: 2px dashed var(--border-soft); font-family: var(--font-hand); font-size: 1.15rem; color: var(--text-muted);">
                            🖱️ <em>Click & drag the corner of this page to peel it!</em>
                        </div>
                    </div>

                    <!-- Page 2: Chapter 2 -->
                    <div class="pf-page">
                        <div class="pf-rings"></div>
                        <span class="planner-tag" style="background:var(--pastel-blue); color:#0369a1; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 2</span>
                        <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.5rem;">Selecting the Right Database</h2>
                        <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.5;">
                            Choosing between Relational (SQL) and Non-Relational (NoSQL) databases depends on data structure consistency and scalability needs.
                        </p>
                        <div style="margin-top: 1.25rem;">
                            <mark class="hl-blue">Relational</mark> <mark class="hl-pink">NoSQL</mark> <mark class="hl-yellow">ACID</mark>
                        </div>
                    </div>

                    <!-- Page 3: Chapter 3 -->
                    <div class="pf-page">
                        <div class="pf-rings"></div>
                        <span class="planner-tag" style="background:var(--pastel-yellow); color:#854d0e; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 3</span>
                        <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.5rem;">Relational Databases & SQL Joins</h2>
                        <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.5;">
                            Structured schemas, tables, primary keys, and foreign keys enforcing rigid data relationships.
                        </p>
                        <div style="margin-top: 1.25rem;">
                            <mark class="hl-blue">MySQL</mark> <mark class="hl-blue">PostgreSQL</mark> <mark class="hl-blue">SQLite</mark>
                        </div>
                    </div>

                    <!-- Page 4: Chapter 4 -->
                    <div class="pf-page">
                        <div class="pf-rings"></div>
                        <span class="planner-tag" style="background:var(--pastel-pink); color:#9d174d; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 4</span>
                        <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.5rem;">ACID Transactions & Data Integrity</h2>
                        <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.5;">
                            Atomicity, Consistency, Isolation, and Durability guarantees across relational databases.
                        </p>
                        <div style="margin-top: 1.25rem;">
                            <mark class="hl-yellow">Atomicity</mark> <mark class="hl-pink">Consistency</mark> <mark class="hl-blue">Isolation</mark> <mark class="hl-green">Durability</mark>
                        </div>
                    </div>

                </div>
            </div>

            <!-- 2. GSAP Arena -->
            <div id="gsapArena">
                
                <!-- GSAP Sheet A (Chapter 3) -->
                <div class="gsap-sheet" id="gsapSheetA" style="z-index: 2;">
                    <div class="pf-rings"></div>
                    <span class="planner-tag" style="background:var(--pastel-blue); color:#0369a1; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 3</span>
                    <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.6rem;">Relational Databases & SQL Joins</h2>
                    <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.6;">
                        Structured schemas, tables, primary keys, and foreign keys enforcing rigid data relationships.
                    </p>
                    <div style="margin-top: 1.25rem;">
                        <mark class="hl-blue">MySQL</mark>
                        <mark class="hl-blue">PostgreSQL</mark>
                        <mark class="hl-blue">SQLite</mark>
                    </div>
                    <div style="margin-top: 1.5rem; padding: 0.8rem; border-radius: 8px; background: var(--paper-card); border: 2px dashed var(--border-soft); font-family: var(--font-hand); font-size: 1.2rem; color: var(--text-muted);">
                        💡 "Tables store rows; relationships link keys."
                    </div>
                </div>

                <!-- GSAP Sheet B (Chapter 4) -->
                <div class="gsap-sheet" id="gsapSheetB" style="z-index: 1;">
                    <div class="pf-rings"></div>
                    <span class="planner-tag" style="background:var(--pastel-yellow); color:#854d0e; font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:8px; font-weight:800;">CHAPTER 4</span>
                    <h2 style="font-family:var(--font-title); margin:0.5rem 0 0.75rem 0; font-size:1.6rem;">ACID Transactions & Data Integrity</h2>
                    <p style="color:var(--text-muted); font-size:0.95rem; line-height:1.6;">
                        Atomicity, Consistency, Isolation, and Durability guarantees across relational databases.
                    </p>
                    <div style="margin-top: 1.25rem;">
                        <mark class="hl-yellow">Atomicity</mark>
                        <mark class="hl-pink">Consistency</mark>
                        <mark class="hl-blue">Isolation</mark>
                        <mark class="hl-green">Durability</mark>
                    </div>
                    <div style="margin-top: 1.5rem; padding: 0.8rem; border-radius: 8px; background: var(--paper-card); border: 2px dashed var(--border-soft); font-family: var(--font-hand); font-size: 1.2rem; color: var(--text-muted);">
                        ⚡ "All or nothing: either the transaction commits completely or rolls back."
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- Client-side Script with Bundled Imports -->
    <script>
        import { PageFlip } from 'page-flip';
        import { gsap } from 'gsap';

        let pageFlipInstance = null;
        let isGsapAActive = true;
        let isGsapAnimating = false;

        // Initialize PageFlip
        function initPageFlip() {
            const container = document.getElementById('bookContainer');
            if (!container || pageFlipInstance) return;

            pageFlipInstance = new PageFlip(container, {
                width: 340,
                height: 440,
                size: 'fixed',
                minWidth: 300,
                maxWidth: 500,
                minHeight: 400,
                maxHeight: 600,
                showCover: false,
                drawShadow: true,
                maxShadowOpacity: 0.5,
                usePortrait: true,
                autoSize: true,
                flippingTime: 700
            });

            pageFlipInstance.loadFromHTML(document.querySelectorAll('.pf-page'));

            document.getElementById('pfNextBtn')?.addEventListener('click', () => {
                pageFlipInstance.flipNext();
            });

            document.getElementById('pfPrevBtn')?.addEventListener('click', () => {
                pageFlipInstance.flipPrev();
            });
        }

        // Initialize GSAP Flip
        function initGsap() {
            const sheetA = document.getElementById('gsapSheetA');
            const sheetB = document.getElementById('gsapSheetB');
            const nextBtn = document.getElementById('gsapNextBtn');
            const prevBtn = document.getElementById('gsapPrevBtn');

            if (!sheetA || !sheetB || !nextBtn || !prevBtn) return;

            function flipForward() {
                if (isGsapAnimating) return;
                isGsapAnimating = true;

                const topSheet = isGsapAActive ? sheetA : sheetB;
                const underSheet = isGsapAActive ? sheetB : sheetA;

                gsap.set(topSheet, { zIndex: 3 });
                gsap.set(underSheet, { zIndex: 1, rotationY: 45, skewY: 5, scale: 0.92, opacity: 0, x: 30, transformOrigin: "left center" });

                const tl = gsap.timeline({
                    onComplete: () => {
                        gsap.set(topSheet, { zIndex: 1, opacity: 0 });
                        gsap.set(underSheet, { zIndex: 2 });
                        isGsapAActive = !isGsapAActive;
                        isGsapAnimating = false;
                    }
                });

                // Top sheet curls and flips out to the left
                tl.to(topSheet, {
                    rotationY: -85,
                    skewY: -8,
                    scale: 0.92,
                    x: -50,
                    opacity: 0,
                    boxShadow: "-35px 20px 45px rgba(0,0,0,0.35)",
                    transformOrigin: "left center",
                    duration: 0.65,
                    ease: "power2.inOut"
                }, 0);

                // Underneath sheet flips into view
                tl.to(underSheet, {
                    rotationY: 0,
                    skewY: 0,
                    scale: 1,
                    x: 0,
                    opacity: 1,
                    boxShadow: "var(--shadow-paper)",
                    transformOrigin: "left center",
                    duration: 0.65,
                    ease: "power2.out"
                }, 0.15);
            }

            function flipBackward() {
                if (isGsapAnimating) return;
                isGsapAnimating = true;

                const topSheet = isGsapAActive ? sheetA : sheetB;
                const underSheet = isGsapAActive ? sheetB : sheetA;

                gsap.set(underSheet, { zIndex: 3, rotationY: -85, skewY: -8, scale: 0.92, x: -50, opacity: 0, transformOrigin: "left center" });
                gsap.set(topSheet, { zIndex: 2 });

                const tl = gsap.timeline({
                    onComplete: () => {
                        gsap.set(topSheet, { zIndex: 1, opacity: 0 });
                        gsap.set(underSheet, { zIndex: 2 });
                        isGsapAActive = !isGsapAActive;
                        isGsapAnimating = false;
                    }
                });

                // Underneath sheet curls in from the left
                tl.to(underSheet, {
                    rotationY: 0,
                    skewY: 0,
                    scale: 1,
                    x: 0,
                    opacity: 1,
                    boxShadow: "var(--shadow-paper)",
                    transformOrigin: "left center",
                    duration: 0.65,
                    ease: "power2.inOut"
                }, 0);

                // Active sheet retreats
                tl.to(topSheet, {
                    rotationY: 45,
                    skewY: 5,
                    scale: 0.92,
                    x: 30,
                    opacity: 0,
                    transformOrigin: "left center",
                    duration: 0.65,
                    ease: "power2.in"
                }, 0.1);
            }

            nextBtn.addEventListener('click', flipForward);
            prevBtn.addEventListener('click', flipBackward);
        }

        // Toggle UI
        window.showLibrary = function(lib) {
            const btnPageFlip = document.getElementById('btnPageFlip');
            const btnGsap = document.getElementById('btnGsap');
            const pfHeader = document.getElementById('pageFlipHeader');
            const gsapHeader = document.getElementById('gsapHeader');
            const pfArena = document.getElementById('pageFlipArena');
            const gsapArena = document.getElementById('gsapArena');

            if (lib === 'pageflip') {
                btnPageFlip.classList.add('active');
                btnGsap.classList.remove('active');
                pfHeader.style.display = 'flex';
                gsapHeader.style.display = 'none';
                pfArena.style.display = 'flex';
                gsapArena.style.display = 'none';
            } else {
                btnPageFlip.classList.remove('active');
                btnGsap.classList.add('active');
                pfHeader.style.display = 'none';
                gsapHeader.style.display = 'flex';
                pfArena.style.display = 'none';
                gsapArena.style.display = 'flex';
            }
        };

        // Mount on DOM Ready
        document.addEventListener('DOMContentLoaded', () => {
            initPageFlip();
            initGsap();
        });

        // Also run immediately if already loaded
        if (document.readyState !== 'loading') {
            initPageFlip();
            initGsap();
        }
    </script>
</body>
</html>

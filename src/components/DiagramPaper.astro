---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`diagram-paper ${className}`.trim()}>
  {title && (
    <div style="font-family: var(--font-title); font-size: 1.15rem; font-weight: 800; margin-bottom: 1.25rem; text-align: center; color: var(--text-main);">
      {title}
    </div>
  )}
  <slot />
</div>
